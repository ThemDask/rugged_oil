# Normalise line endings so text files diff cleanly across machines.
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets. When the art/audio volume grows, move these to Git LFS
# (git lfs track "*.png" etc.) instead of storing them directly.
*.png  binary
*.jpg  binary
*.webp binary
*.svg  text
*.ogg  binary
*.wav  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.woff2 binary
