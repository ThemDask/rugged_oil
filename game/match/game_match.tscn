[gd_scene format=3]

[ext_resource type="Script" path="res://match/game_match.gd" id="1_match"]
[ext_resource type="Script" path="res://systems/selection/selection_system.gd" id="2_selection"]
[ext_resource type="Script" path="res://systems/commands/command_dispatcher.gd" id="3_dispatcher"]
[ext_resource type="Script" path="res://systems/camera/rts_camera.gd" id="4_camera"]
[ext_resource type="Script" path="res://ui/hud/debug_overlay.gd" id="5_debug"]

[node name="GameMatch" type="Node2D"]
script = ExtResource("1_match")

[node name="Units" type="Node2D" parent="."]

[node name="SelectionSystem" type="Node2D" parent="."]
script = ExtResource("2_selection")

[node name="CommandDispatcher" type="Node" parent="."]
script = ExtResource("3_dispatcher")

[node name="RtsCamera" type="Camera2D" parent="."]
script = ExtResource("4_camera")

[node name="HUD" type="CanvasLayer" parent="."]

[node name="DebugOverlay" type="Label" parent="HUD"]
offset_left = 8.0
offset_top = 8.0
script = ExtResource("5_debug")

[connection signal="selection_changed" from="SelectionSystem" to="HUD/DebugOverlay" method="on_selection_changed"]
